{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guaihaowan",
  "main": "worker/index.ts",
  // 对齐当前 Wrangler 内置 workerd 支持的最新日期，保证默认 wrangler dev 可启动。
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/tacit-test/c*", "/next-question/c/*"]
  },
  "analytics_engine_datasets": [
    { "binding": "PRODUCT_ANALYTICS", "dataset": "guaihaowan_product_events" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_QUESTION_CHAINS", "class_name": "NextQuestionChain" }
    ]
  },
  // 1003 是本仓库为下一问保留的正整数 namespace；生产部署前确认账户内未被其他 Worker 占用。
  "ratelimits": [
    {
      "name": "NEXT_QUESTION_CREATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // 按住不放成本熔断：只有 'true' 且 HOLD_DB/HOLD_SESSION_SECRET 齐备时开放服务端成绩。
  // HOLD_DB（d1_databases）与 HOLD_SUBMIT_LIMITER 需生产创建后由人工授权写入，不在此伪造 id。
  "vars": { "HOLD_SCORES_ENABLED": "false" },
  // 每日清理 hold-button 的过期 sessions / runs / histogram（UTC 18:00 ≈ 北京 02:00）。
  "triggers": { "crons": ["0 18 * * *"] },
  "exports": {
    "NextQuestionChain": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
