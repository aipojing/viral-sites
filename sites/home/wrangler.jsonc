{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guaihaowan",
  "main": "worker/index.ts",
  // 实施当天（2026-08-09）的真实日期
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/tacit-test/c*"]
  },
  "analytics_engine_datasets": [
    { "binding": "PRODUCT_ANALYTICS", "dataset": "guaihaowan_product_events" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_QUESTION_CHAINS", "class_name": "NextQuestionChain" }
    ]
  },
  "exports": {
    "NextQuestionChain": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": { "enabled": true }
}
